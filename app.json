{
  "expo": {
    "name": "hook",
    "slug": "hook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": [
      "hook",
      "com.googleusercontent.apps.970939309798-beud2kvciukbrbpau74oosnmlf97de2r"
    ],
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.biodun42.hook",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Hook uses Face ID to protect your account on this device."
      }
    },
    "android": {
      "package": "com.biodun42.hook",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFC809",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "translucent": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/web-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Hook to use Face ID to protect your account."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FFC809"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFC809",
          "dark": {
            "backgroundColor": "#FFC809"
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.970939309798-beud2kvciukbrbpau74oosnmlf97de2r"
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2f9f9545-f2d2-49f9-8e88-650d9ce14df6"
      }
    },
    "owner": "biodun42"
  }
}
